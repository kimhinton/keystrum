# Cloudflare Pages headers config.
# Forces correct Content-Type for Next.js metadata routes that generate
# images at runtime — without this, Cloudflare Pages serves them as
# application/octet-stream, breaking SERP thumbnails, OG previews,
# and Twitter cards.

/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=86400, must-revalidate

/twitter-image
  Content-Type: image/png
  Cache-Control: public, max-age=86400, must-revalidate

/icon
  Content-Type: image/png
  Cache-Control: public, max-age=86400, must-revalidate

/apple-icon
  Content-Type: image/png
  Cache-Control: public, max-age=86400, must-revalidate

/chords/*/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=86400, must-revalidate

/play/*/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=86400, must-revalidate

# Security headers for the whole site.
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https:; media-src 'self' blob:; worker-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; manifest-src 'self'
  Cross-Origin-Opener-Policy: same-origin
